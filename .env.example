
# For running LLMs hosted by openai (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# Optional for accessing Finnhub news API
# Get your Finnhub API key from https://finnhub.io/
FINNHUB_API_KEY=your-finnhub-api-key

# Alpaca API keys for paper trading and data access from https://alpaca.markets/
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-api-secret
